<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <!-- HT02687: columnas 'Palet' y 'Cantidad palet' en las operaciones
       detalladas (junto a Empaquetado/Cantidad de paquetes, antes de Cantidad) -->
  <record id="view_stock_move_line_detailed_operation_tree" model="ir.ui.view">
    <field name="model">stock.move.line</field>
    <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree" />
    <field name="arch" type="xml">
      <field name="quantity" position="before">
        <field name="palet_id" optional="show" />
        <field name="palet_qty" optional="show" sum="Total Cantidad palet" />
      </field>
    </field>
  </record>
</odoo>
