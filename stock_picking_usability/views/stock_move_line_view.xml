<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_stock_move_line_kanban" model="ir.ui.view">
    <field name="model">stock.move.line</field>
    <field name="inherit_id" ref="stock.view_stock_move_line_kanban" />
    <field name="priority">100</field>
    <field name="arch" type="xml">
      <kanban position="attributes">
        <attribute name="delete">1</attribute>
      </kanban>
      <xpath expr="//t[@t-name='card']/div[1]" position="before">
        <a
          t-if="! read_only_mode"
          type="delete"
          style="position: absolute; right: 0; padding: 4px; display: inline-block"
        >X</a>
      </xpath>
      <xpath expr="//div[@groups='stock.group_production_lot']" position="replace">
        <div
          groups="stock.group_production_lot"
          invisible="not lot_id and not lot_name"
        >
                    Lot:
                    <field name="lot_id" invisible="not lot_id and lot_name" />
                    <field name="lot_name" invisible="lot_id or not lot_name" />
                </div>
      </xpath>
      <xpath expr="//field[@name='product_uom_id']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='quantity']" position="replace">
        <div>
          <span>
                        Quantity:
                        <field name="quantity" />
                        <field name="product_uom_id" groups="uom.group_uom" />
                    </span>
        </div>
      </xpath>
    </field>
  </record>

  <!-- HT02687: "Paquete origen" y "Paquete destino" no deben mostrarse en las
       operaciones detalladas. El core trae package_id y un result_package_id
       como auxiliares ocultos (column_invisible=True) y otro result_package_id
       visible para usuarios de paquetes; el parche de custom_breeding_apps
       (módulo de cría de Tolvasa) reescribía el column_invisible de los
       auxiliares y los des-ocultaba. priority=20 para aplicarse después de
       esos parches. Proalpe no usa paquetes (0 de 1,3M de líneas). -->
  <record id="view_stock_move_line_detailed_operation_tree_no_packages" model="ir.ui.view">
    <field name="model">stock.move.line</field>
    <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree" />
    <field name="priority">20</field>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='package_id']" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>
      <xpath expr="//field[@name='result_package_id'][not(@groups)]" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>
      <xpath
        expr="//field[@name='result_package_id'][@groups='stock.group_tracking_lot']"
        position="attributes"
      >
        <attribute name="column_invisible">True</attribute>
      </xpath>
      <!-- HT02687: 'Tomar de' y el 'Hasta' que sale tras 'Fecha de caducidad'
           (el location_dest_id del core) no deben mostrarse. -->
      <xpath expr="//field[@name='quant_id']" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>
      <xpath
        expr="//field[@name='location_dest_id'][@groups='stock.group_stock_multi_locations']"
        position="attributes"
      >
        <attribute name="column_invisible">True</attribute>
      </xpath>
      <!-- 'Desde' queda oculto por defecto (se puede mostrar desde las columnas
           opcionales) -->
      <xpath expr="//field[@name='location_id']" position="attributes">
        <attribute name="optional">hide</attribute>
      </xpath>
    </field>
  </record>
</odoo>
