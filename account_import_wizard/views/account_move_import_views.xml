<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="account_move_import_view_tree" model="ir.ui.view">
        <field name="model">account.move.import</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'done'" decoration-bf="state == 'pass'">
                <field name="name"/>
                <field name="file_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="account_move_import_view_form" model="ir.ui.view">
        <field name="model">account.move.import</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
            name="action_import_file"
            string="Importar"
            type="object"
            class="oe_read_only"
            states="draft,2validate,pass,error"
          />
                    <button
            name="action_validate"
            string="Validate"
            type="object"
            class="oe_read_only"
            states="2validate,error"
          />
                    <button
            name="action_process"
            string="Process"
            type="object"
            class="oe_read_only"
            states="2validate,pass,error"
          />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
              string="Import Lines"
              type="object"
              name="button_open_import_line"
              attrs="{'invisible':[('import_line_ids', '=', [])]}"
              class="oe_stat_button"
              icon="fa-bars"
            />
                        <button
              type="object"
              name="button_open_account_move"
              attrs="{'invisible':[('account_move_count', '=', 0)]}"
              class="oe_stat_button"
              icon="fa-folder-open"
            >
                            <field name="account_move_count" widget="statinfo" />
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="filename"/>
                            <field name="data" filename="filename"/>
                            <field name="file_date"/>
                        </group>
                        <group>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Imported Lines">
                            <field name="import_line_ids"/>
                        </page>
                        <page
              string="Error Log"
              attrs="{'invisible':[('log_info','=','')]}"
            >
                            <field name="log_info" />
                        </page>
                        <page
              string="Help"
              name="help_page"
              attrs="{'invisible': [('state', '=', 'done')]}"
            >
                            <group>
                                <div style="margin-top: 4px;">
                                    <h3>Help with Excel column names</h3>
                                    <p
                  >You must use this column names in order to fill the table:</p>
                                    <ul name="tutorial">
                                        <li><code>codigocliente</code>: this will fill <b
                      >Código cliente</b></li>
                                        <li><code>nombrecliente</code>: this will fill <b
                      >Nombre Cliente</b></li>
                                        <li><code>fechafactura</code>: this will fill <b
                      >Fecha factura</b></li>
                                        <li><code>fechavencimiento</code>: this will fill <b
                      >Fecha vencimiento</b></li>
                                        <li><code>totalsinimpuestos</code>: this will fill <b
                      >Total sin impuestos</b></li>
                                        <li><code>totalconimpuestos</code>: this will fill <b
                      >Total com impuestos</b></li>
                                        <li><code>entrada</code>: this will fill <b
                      >Entrada</b></li>
                                        <li><code>codigoproducto</code>: this will fill <b
                      >Referencia del producto</b></li>
                                        <li><code>nombreproducto</code>: this will fill <b
                      >Nombre del producto</b></li>
                                        <li><code>cantidad</code>: this will fill <b
                      >Cantidad de producto</b></li>
                                        <li><code>preciounitario</code>: this will fill <b
                      >Precio unitario</b></li>
                                        <li><code>descuento</code>: this will fill <b
                      >Descuento</b></li>
                                        <li><code>estado</code>: this will fill <b
                      >Estado</b></li>
                                        <!-- <li><code>EstadoPago</code>: this will fill <b
                      >Estado de pago</b></li> -->
                                    </ul>
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="account_move_import_view_search" model="ir.ui.view">
        <field name="model">account.move.import</field>
        <field name="arch" type="xml">
            <search>
                <field name="file_date" />
                <filter
          name="pending"
          string="Pending"
          domain="[('state', '!=', 'done')]"
        />
                <filter
          name="finished"
          string="Done"
          domain="[('state', '=', 'done')]"
        />
                <filter
          name="errored"
          string="Error"
          domain="[('state', '=', 'error')]"
        />
                <group expand="0" string="Group By">
                    <filter
            string="Status"
            name="state_group"
            domain="[]"
            context="{'group_by':'state'}"
          />
                </group>
            </search>
        </field>
    </record>

    <record id="account_move_import_action" model="ir.actions.act_window">
        <field name="name">Import Account Moves</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.move.import</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="account_move_import_view_tree"/>
    </record>

    <menuitem
    id="account_move_import_menu"
    action="account_move_import_action"
    parent="base_import_wizard.base_import_menu"
    sequence="10"
  />

    <menuitem
    id="account_move_import_menu"
    action="account_move_import_action"
    parent="account.menu_account_config"
    sequence="5"
  />

</odoo>
