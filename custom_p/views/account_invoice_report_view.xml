<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- v14: a record removed disable_linking from
         account.view_account_invoice_report_pivot to allow drill-down. In v18
         that attribute is gone (linking is enabled by default), so the record
         is dropped. -->
    <record id="view_account_invoice_report_tree" model="ir.ui.view">
        <field name="name">account.invoice.report.view.tree</field>
        <field name="model">account.invoice.report</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="move_id"/>
                <field name="invoice_date"/>
                <field name="invoice_date_due"/>
                <field name="partner_id"/>
                <field name="commercial_partner_id"/>
                <field name="account_id"/>
                <field name="payment_mode_id"/>
                <field name="journal_id"/>
                <field name="invoice_user_id"/>
                <field name="fiscal_position_id"/>
                <field name="sale_type_id"/>
                <field name="team_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="product_uom_id"/>
            </list>
        </field>
    </record>
</odoo>