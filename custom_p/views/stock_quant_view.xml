<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- v14: this field/column was on stock.inventory.line (view
         stock.stock_inventory_line_tree). In v18 inventory adjustment lines
         are stock.quant records edited in stock.view_stock_quant_tree_inventory_editable. -->
    <record id="view_stock_quant_tree_inventory_editable" model="ir.ui.view">
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable" />
        <field name="arch" type="xml">
            <field name="owner_id" position="after">
                <field name="container" sum="Total containers" optional="show" />
            </field>
        </field>
    </record>
</odoo>
